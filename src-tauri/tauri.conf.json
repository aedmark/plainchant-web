{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainchant Web",
  "version": "1.0.0",
  "identifier": "io.plainchant.web",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plainchant Web — HTML5, CSS & JS Studio",
        "url": "app.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
