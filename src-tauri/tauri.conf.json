{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainchant Web",
  "version": "1.0.0",
  "identifier": "io.plainchant.web",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plainchant Web — HTML5, CSS & JS Studio",
        "url": "app.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Dreamweaver-inspired HTML5, CSS, and JS WYSIWYG studio",
    "longDescription": "Lightweight HTML5, CSS, and vanilla JavaScript WYSIWYG studio where your project's source files remain the single source of truth."
  }
}
